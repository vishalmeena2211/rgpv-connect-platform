# --- RGPV Result Worker configuration ---

# Comma-separated list of origins allowed to call this service.
ALLOWED_ORIGINS=http://localhost:3000

# Base URL of the RGPV result portal (override only if RGPV changes domains).
RGPV_BASE_URL=http://result.rgpv.ac.in/Result

# Redis connection used by the session pool.
REDIS_URL=redis://localhost:6379

# Log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Rate limit applied to the bulk endpoint (slowapi syntax).
BULK_RATE_LIMIT=5/minute
