# --- Web app environment ---

# Database (shared with @rgpv/db)
DATABASE_URL="postgresql://rgpv:rgpv@localhost:5432/rgpv_connect?schema=public"

# Auth.js — generate a secret with: openssl rand -base64 32
AUTH_SECRET="changeme-dev-secret"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
